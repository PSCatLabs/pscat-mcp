{
  "id": "runaway-timeout",
  "title": "Scenario 5a variant: with PSCat's limits off, only the external kill stops the loop (timeout)",
  "origin": "examples/agent-scenarios.md section 5a; scripts/container-smoke.sh",
  "server_env": {
    "PSCAT_MCP_RENDER_TIMEOUT_MS": "1500",
    "PSCAT_MCP_INTERP_TIME_LIMIT_MS": "0",
    "PSCAT_MCP_MAX_STEPS": "0",
    "PSCAT_MCP_MAX_CONCURRENT_RENDERS": "1",
    "PSCAT_MCP_QUEUE_TIMEOUT_MS": "300"
  },
  "steps": [
    {
      "label": "{ 1 pop } loop",
      "tool": "render_postscript",
      "args": {
        "source": "%!PS\n{ 1 pop } loop\n"
      },
      "result": {
        "is_error": true,
        "error_code": "timeout",
        "forbid_content_types": [
          "image",
          "resource"
        ],
        "structured": {
          "ok": false,
          "error.code": "timeout",
          "error.message": "the render ran past 1500 ms and was stopped"
        },
        "elapsed_ms": {
          "min": 1400,
          "max": 10000
        },
        "renders_executed": 1
      }
    },
    {
      "label": "the slot is free again and the server renders",
      "tool": "render_postscript",
      "args": {
        "source": "%!PS\nshowpage\n"
      },
      "result": {
        "content_types": [
          "image:image/png"
        ],
        "png": {
          "width": 612,
          "height": 792
        },
        "structured": {
          "ok": true
        }
      }
    }
  ]
}
