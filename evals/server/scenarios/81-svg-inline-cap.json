{
  "id": "svg-inline-cap",
  "title": "SVG is capped inline separately from PNG and PDF: output_too_large with error.input.code svg_bytes at PSCAT_MCP_MAX_SVG_BYTES",
  "origin": "issue #52; README Current limitations",
  "server_env": {
    "PSCAT_MCP_MAX_SVG_BYTES": "20000"
  },
  "steps": [
    {
      "label": "the cap is in get_renderer_info",
      "tool": "get_renderer_info",
      "args": {},
      "result": {
        "structured": {
          "limits.max_svg_bytes": 20000
        }
      }
    },
    {
      "label": "a small SVG under the cap is returned",
      "tool": "render_postscript",
      "args": {
        "source": "%!PS\n1 0 0 setrgbcolor 0 0 100 100 rectfill\nshowpage\n",
        "width": 100,
        "height": 100,
        "format": "svg"
      },
      "result": {
        "content_types": [
          "resource:image/svg+xml",
          "text"
        ],
        "structured": {
          "ok": true,
          "format": "svg"
        }
      }
    },
    {
      "label": "an SVG of thousands of marks is over the cap",
      "tool": "render_postscript",
      "args": {
        "source": "%!PS\n1 srand 0 1 2000 { pop rand 500 mod rand 500 mod 3 3 rectfill } for\nshowpage\n",
        "width": 500,
        "height": 500,
        "format": "svg"
      },
      "result": {
        "is_error": true,
        "error_code": "output_too_large",
        "forbid_content_types": [
          "image",
          "resource"
        ],
        "structured": {
          "ok": false,
          "error.code": "output_too_large",
          "error.input.code": "svg_bytes",
          "error.input.limit_bytes": 20000,
          "error.input.reached_bytes": {
            "min": 20001
          },
          "error.message": {
            "contains": [
              "at most 20000 bytes of SVG",
              "PSCAT_MCP_MAX_SVG_BYTES",
              "use png or pdf",
              "lower the page size",
              "simplify the program"
            ]
          }
        },
        "text_contains": [
          "output_too_large",
          "20000 bytes"
        ]
      }
    },
    {
      "label": "the same program as PNG is held to the output cap only",
      "tool": "render_postscript",
      "args": {
        "source": "%!PS\n1 srand 0 1 2000 { pop rand 500 mod rand 500 mod 3 3 rectfill } for\nshowpage\n",
        "width": 500,
        "height": 500,
        "format": "png"
      },
      "result": {
        "content_types": [
          "image:image/png",
          "text"
        ],
        "structured": {
          "ok": true
        }
      }
    },
    {
      "label": "a chalkboard's SVG, which runs to megabytes, is over the cap with advice for boards",
      "tool": "chalkboard_math",
      "args": {
        "latex": "\\frac{1}{2}",
        "format": "svg",
        "width": 300,
        "height": 150,
        "dpi": 72
      },
      "result": {
        "is_error": true,
        "error_code": "output_too_large",
        "forbid_content_types": [
          "image",
          "resource"
        ],
        "structured": {
          "ok": false,
          "error.input.code": "svg_bytes",
          "error.input.limit_bytes": 20000,
          "error.message": {
            "contains": [
              "runs to megabytes",
              "png is the practical format"
            ]
          }
        }
      }
    }
  ]
}
