{
  "id": "render-halftone",
  "title": "Scenario 1 variant: the same program screened like a mono laser printer (halftone)",
  "origin": "examples/agent-scenarios.md section 1 (halftone variant)",
  "max_turns": 6,
  "prompt": "Render this PostScript as a PNG screened like a mono laser printer (a halftone, black and white dots only) with the pscat-render tools (400×300 points), and tell me what came back:\n\n{{file:examples/shapes.ps}}",
  "expect": {
    "tools_required": [
      "render_postscript"
    ],
    "calls": [
      {
        "tool": "render_postscript",
        "args": {
          "source": {
            "equals_text": "{{file:examples/shapes.ps}}"
          },
          "halftone": true,
          "format": {
            "in": [
              "png",
              null
            ]
          }
        },
        "result": {
          "is_error": false,
          "content_types": [
            "image"
          ],
          "structured": {
            "ok": true,
            "format": "png"
          }
        }
      }
    ],
    "answer": {
      "any": [
        [
          "halftone",
          "dots",
          "dot pattern",
          "black and white",
          "black-and-white"
        ]
      ]
    }
  }
}
