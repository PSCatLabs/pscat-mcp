{
  "id": "huge-source",
  "title": "Scenario 5c: a source over 256 KiB (source_too_large), or a disclosed shortened copy; tens of thousands of tokens",
  "origin": "examples/agent-scenarios.md section 5c",
  "tags": [
    "expensive"
  ],
  "transports": [
    "stdio"
  ],
  "max_turns": 6,
  "timeout_s": 600,
  "prompt": "Using the pscat-render tools, render this PostScript file exactly as given:\n\n%!PS\n{{huge_source}}showpage\n",
  "expect_any_of": [
    {
      "calls": [
        {
          "tool": "render_postscript",
          "result": {
            "is_error": true,
            "error_code": "source_too_large"
          }
        }
      ],
      "answer": {
        "any": [
          [
            "loop",
            "procedure",
            "simplif",
            "smaller",
            "shorter"
          ]
        ]
      }
    },
    {
      "tools_forbidden": [
        "render_postscript"
      ],
      "answer": {
        "any": [
          [
            "loop",
            "procedure",
            "simplif",
            "smaller",
            "shorter",
            "too large",
            "limit"
          ]
        ]
      }
    },
    {
      "calls": [
        {
          "tool": "render_postscript",
          "result": {
            "is_error": false
          }
        }
      ],
      "answer": {
        "regex": [
          "shorten|shorter|not the (exact|full|original)|condens|truncat|fewer (lines|repeats|copies)|didn't (send|pass|render) the (whole|full|entire)"
        ]
      }
    }
  ],
  "notes": "The third alternative (#44 triage): the agent renders a shortened copy and says so. Emitting 285 KB as one tool argument is not a realistic agent action, and the answer must not pass the copy off as the original."
}
