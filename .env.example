# pscat-mcp-server configuration (container / Cloud Run environment).
#
# Copy to .env for local use (`docker run --env-file .env ...`); .env is
# git- and docker-ignored. Every variable is optional unless noted; the
# value shown is the built-in default, except where marked "example".
# Each variable also has a matching command-line flag (`--help`).
# Never commit real tokens: in production use a secret manager and
# PSCAT_MCP_AUTH_TOKEN_FILE (a mounted secret) or a secret-backed env var.

# ---------------------------------------------------------------------------
# HTTP transport (serve-http)
# ---------------------------------------------------------------------------

# Address to bind. The binary defaults to 127.0.0.1; the container image sets
# 0.0.0.0 so the published port is reachable.
PSCAT_MCP_BIND=0.0.0.0

# Port to listen on. Cloud Run injects PORT itself.
PORT=8080

# REQUIRED when PSCAT_MCP_AUTH is unset or lists `bearer`, unless a token
# file is given (or unauthenticated loopback dev). Not needed for an
# `oauth`-only server.
# Bearer tokens accepted on /mcp, comma-separated, so tokens can be rotated
# by listing old and new together. Generate with: openssl rand -hex 32
PSCAT_MCP_AUTH_TOKENS=replace-with-a-long-random-token

# Alternative to the above: a file with one token per line (blank lines and
# `#` comments ignored), e.g. a Cloud Run secret mounted as a volume.
# Tokens from both sources are accepted.
# PSCAT_MCP_AUTH_TOKEN_FILE=/secrets/pscat-mcp-tokens

# Serve /mcp without authentication. Refused unless the bind address is
# loopback, so it cannot be used inside a container bound to 0.0.0.0.
# Local development only.
PSCAT_MCP_ALLOW_UNAUTHENTICATED=false

# Auth methods accepted on /mcp, comma-separated, tried in turn: a request
# passes if any of them accepts it. Unset (the default): bearer tokens as
# above, or PSCAT_MCP_ALLOW_UNAUTHENTICATED on loopback. `bearer`, `oauth`
# (below) and `none` exist; an empty, unknown or repeated list is refused. When set, PSCAT_MCP_ALLOW_UNAUTHENTICATED is
# ignored (and still refused off loopback).
# `none` is NO AUTHENTICATION, for STAGING only (for example ChatGPT's "No
# authentication" connector): anyone with the URL can spend render CPU time.
# It is never on by default, logs a warning at startup, and the server
# refuses it together with PSCAT_MCP_ASYNC_JOBS. `bearer,none` lets valid
# tokens in as themselves, requests with no Authorization header in as
# anonymous, and rejects a wrong token.
# PSCAT_MCP_AUTH=bearer
# PSCAT_MCP_AUTH=bearer,none
# PSCAT_MCP_AUTH=bearer,oauth

# Guard rails of `none` (all ignored unless `none` is in PSCAT_MCP_AUTH).
# After this RFC 3339 time anonymous requests get 403. A time that has already
# passed at startup does not stop the server: `none` is disabled with a
# warning and the other methods keep working. A malformed time refuses to
# start.
# PSCAT_MCP_AUTH_NONE_UNTIL=2026-12-01T00:00:00Z
# Source CIDRs allowed to make anonymous requests (others get 403). Unset:
# any source.
# PSCAT_MCP_AUTH_NONE_ALLOW_CIDRS=203.0.113.0/24,2001:db8::/32
# Anonymous requests per client address per window, then 429 with
# Retry-After. Per server instance.
# PSCAT_MCP_AUTH_NONE_RATE_LIMIT=60
# PSCAT_MCP_AUTH_NONE_RATE_WINDOW_SECS=60
# Trusted proxies in front of the server. 0: the client is the TCP peer and
# X-Forwarded-For is ignored. N: the client is the N-th entry from the right
# of X-Forwarded-For. Cloud Run (docs/CLOUD_RUN.md): 1 on *.run.app, 2
# behind an external Application Load Balancer.
# PSCAT_MCP_AUTH_NONE_TRUSTED_HOPS=0

# --- OAuth (PSCAT_MCP_AUTH lists `oauth`) ----------------------------------
# JWT access tokens from an external authorization server (for ChatGPT and
# claude.ai connectors). The server needs no secret for this: it verifies
# signatures with the issuer's public keys (JWKS), fetched over HTTPS.

# REQUIRED for oauth. The issuer URL, exactly as in tokens' `iss` (https).
# PSCAT_MCP_OAUTH_ISSUER=https://issuer.example.com/

# REQUIRED for oauth. This server's public URL as clients connect to it
# (RFC 8707 resource); tokens' `aud` must contain it. Also names the
# metadata URL /.well-known/oauth-protected-resource/mcp.
# PSCAT_MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp

# REQUIRED for oauth (one or both). Who may use the server: `sub:<subject>`
# or `email:<address>` (email entries match only when the access token says
# email_verified: true). Comma list, or a file with one entry per line.
# PSCAT_MCP_OAUTH_ALLOWED_USERS=sub:example-subject,email:someone@example.com
# PSCAT_MCP_OAUTH_ALLOWED_USERS_FILE=/secrets/pscat-mcp-allowed-users

# Scopes every token must carry, comma-separated; also published in the
# metadata. Empty (default): no scope check.
# PSCAT_MCP_OAUTH_SCOPES=

# JWKS URL. Unset (default): discovered from the issuer's metadata.
# PSCAT_MCP_OAUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json

# Timeout of one JWKS/discovery fetch and of a whole key lookup (ms).
PSCAT_MCP_OAUTH_JWKS_TIMEOUT_MS=5000
# How long fetched keys are used before they are fetched again (s).
PSCAT_MCP_OAUTH_JWKS_TTL_SECS=600
# Least time between two JWKS fetch attempts (s): unknown key ids cannot
# make the server hammer the issuer.
PSCAT_MCP_OAUTH_JWKS_REFETCH_SECS=30
# Clock-skew leeway for exp and nbf (s).
PSCAT_MCP_OAUTH_LEEWAY_SECS=60

# Host header values accepted (DNS-rebinding protection), comma-separated.
# Set this to your public hostname, e.g. pscat-mcp-abc123-uc.a.run.app.
# `*` accepts any host: only behind a proxy that already validates Host.
PSCAT_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Browser origins accepted, comma-separated. Empty (default): any request
# carrying an Origin header is rejected; MCP clients do not send one.
# PSCAT_MCP_ALLOWED_ORIGINS=https://example.com

# Seconds to wait for in-flight requests after SIGTERM before exiting.
# Cloud Run allows 10 s by default.
PSCAT_MCP_SHUTDOWN_GRACE_SECS=8

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# json (default for serve-http, one object per line on stderr) or pretty.
PSCAT_MCP_LOG_FORMAT=json

# tracing filter; replaces the default `info`. The rmcp crate's targets stay
# at WARN and ERROR whatever this says: rmcp logs whole messages (the
# initialize parameters, requests, artifact links) below WARN.
# RUST_LOG=info,pscat_mcp=debug

# ---------------------------------------------------------------------------
# Resource limits (one render)
# ---------------------------------------------------------------------------

# Largest PostScript source accepted, in bytes (256 KiB). Checked before
# anything runs: larger sources fail with `source_too_large`.
PSCAT_MCP_MAX_SOURCE_BYTES=262144

# Largest LaTeX formula chalkboard_math accepts, in bytes (the PSCat
# plugin's default). Checked before anything runs (`source_too_large`). A
# ten-row derivation is about 1 KB; a much longer formula may not finish
# inside the render timeout.
PSCAT_MCP_MAX_LATEX_BYTES=4096

# Largest text handwrite accepts, in bytes (64 KiB; the PSCat plugin's is
# 1 MiB, but a note within the pixel limits holds far less, and a larger
# value raises the HTTP request-body limit above the source limit's). Checked before anything runs (`source_too_large`). The
# note's size is bounded by PSCAT_MCP_MAX_PIXELS and the 8000-pixel side
# limit whatever the text: a text that lays out taller is `too_many_pixels`
# or `invalid_dimensions`, before the note is drawn.
PSCAT_MCP_MAX_HANDWRITE_BYTES=65536

# Longest value of one guide prompt argument (prompts/get of diagram,
# generative_art, chart), in bytes; longer is a JSON-RPC invalid_params
# error. Prompt arguments are only copied into the prompt text.
PSCAT_MCP_MAX_PROMPT_ARGUMENT_BYTES=8192

# Wall-clock deadline per render, in ms. The worker process is SIGKILLed when
# it passes (`timeout`).
PSCAT_MCP_RENDER_TIMEOUT_MS=20000

# PSCat's own time limit, in ms. Unset: the render timeout minus 10% (at
# least 250 ms), so runaways usually stop cleanly with `limit_exceeded`
# before the kill. 0 disables it (the kill still applies). Must be below
# PSCAT_MCP_RENDER_TIMEOUT_MS.
# PSCAT_MCP_INTERP_TIME_LIMIT_MS=18000

# PSCat's step limit (objects executed). 0 disables it.
PSCAT_MCP_MAX_STEPS=5000000000

# PSCat's heap-growth limit for one program, in bytes (512 MiB). 0 disables.
PSCAT_MCP_MAX_MEMORY_BYTES=536870912

# RLIMIT_AS for each worker process, in bytes. Unset: the memory limit plus
# 1 GiB of headroom. 0 disables. Keep it under the container memory limit
# times the number of concurrent renders you allow.
# PSCAT_MCP_WORKER_ADDRESS_SPACE_BYTES=1610612736

# Most device pixels on one page (width x height at the requested dpi).
# Larger pages fail with `too_many_pixels` before execution. PSCat also caps
# each side at 8000 px (`invalid_dimensions`).
PSCAT_MCP_MAX_PIXELS=16000000

# Most pages one render may return (`too_many_pages`).
PSCAT_MCP_MAX_PAGES=10

# Most bytes of rendered output (all pages, before base64) returned inline
# (8 MiB, `output_too_large`).
PSCAT_MCP_MAX_OUTPUT_BYTES=8388608

# Most bytes of SVG (all pages together) returned as embedded text
# resources, which a client can show the model as markup. A larger SVG is
# returned as embedded blob resources (base64), held to
# PSCAT_MCP_MAX_OUTPUT_BYTES: Claude Code saves those as .svg files and
# gives the model the path, while it shows a text result inline only up to
# about 50,000 characters (docs/LOCAL_TESTING.md, section 11). 0 returns
# every SVG as a blob. Unset: 40 KiB, or the output limit if that is
# smaller. May not exceed PSCAT_MCP_MAX_OUTPUT_BYTES (the server refuses
# to start).
# PSCAT_MCP_SVG_BLOB_THRESHOLD_BYTES=40960

# Most bytes of program stdout (`print`, `=`, `==`) returned (16 KiB).
PSCAT_MCP_MAX_PROGRAM_OUTPUT_BYTES=16384

# Renders running at once. Unset: the CPU count, at most 4. Each render is
# one worker process, so memory use scales with this. On Cloud Run's
# first-generation environment (gVisor) the CPU count can exceed the
# service's --cpu: set this equal to --cpu there.
# PSCAT_MCP_MAX_CONCURRENT_RENDERS=2

# How long a render waits for a free slot before `server_busy`, in ms.
PSCAT_MCP_QUEUE_TIMEOUT_MS=10000

# review_sheet: several programs at several dpis composed into one PNG. A
# sheet is one worker job in one render slot; every budget below is checked
# before it starts. Each cell also gets the render's step, time and memory
# limits, and at most an equal share of the time the sheet has left.
#
# Most cells (dpi items over all rows) in one sheet; the plugin's cap.
PSCAT_MCP_MAX_SHEET_CELLS=32
# Most source bytes in one sheet, all entries together (`source_too_large`).
# Unset: PSCAT_MCP_MAX_SOURCE_BYTES, which also bounds each entry. Raises the
# HTTP request-body limit if larger than the source limit.
# PSCAT_MCP_MAX_SHEET_SOURCE_BYTES=262144
# Most device pixels the cells render, all together, before zoom
# (`too_many_pixels`). Unset: PSCAT_MCP_MAX_PIXELS.
# PSCAT_MCP_MAX_SHEET_CELL_PIXELS=16000000
# Most device pixels of the composed sheet (`too_many_pixels`; 8000 a side,
# `invalid_dimensions`), at most 64000000. Unset: PSCAT_MCP_MAX_PIXELS (capped
# at 64000000). The worker holds the sheet, 4 bytes a pixel, beside each
# cell, outside the cell's memory limit: see docs/CLOUD_RUN.md, "Sizing".
# PSCAT_MCP_MAX_SHEET_PIXELS=16000000
# Wall-clock deadline of a whole sheet, in ms; its worker is SIGKILLed when
# it passes (`timeout`). The cells share it less 10% (at least 250 ms), and
# a sheet whose cells cannot each have 100 ms of that, after 250 ms for its
# labels, is refused before it starts. Unset: PSCAT_MCP_RENDER_TIMEOUT_MS.
# The Cloud Run request timeout must exceed the larger of this and the
# render timeout, plus the queue timeout.
# PSCAT_MCP_MAX_SHEET_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Async render jobs (start_render, render_status, render_result, cancel_render)
# ---------------------------------------------------------------------------

# serve-http only (stdio always has them): serve async jobs. Off by default.
# Jobs and results live in this process's memory, so this works only on ONE
# instance whose CPU stays allocated between requests; not on an autoscaled
# or request-billed Cloud Run service (see docs/CLOUD_RUN.md).
# PSCAT_MCP_ASYNC_JOBS=false
# Also serve the MCP Tasks extension (io.modelcontextprotocol/tasks) on top
# of the jobs: a tools/call that declares it and is still running after
# PSCAT_MCP_TASK_AFTER_MS becomes a task (the client gets a task handle). Needs
# async jobs. Off by default.
# PSCAT_MCP_TASKS=false
# With PSCAT_MCP_TASKS: how long a Tasks client's call runs, in ms from when its
# worker starts, before it becomes a task. A quicker call returns its result
# directly and never touches the job caps or budget; one that cannot become a
# task then (caps, budget, no running-job permit) is held to the sync deadline.
# Below PSCAT_MCP_RENDER_TIMEOUT_MS; 0 makes every such call a task at once.
# Above 0 the call's worker starts under the job limits, so they must be no
# tighter than the sync ones: PSCAT_MCP_JOB_TIMEOUT_MS at least
# PSCAT_MCP_RENDER_TIMEOUT_MS, the job step limit at least PSCAT_MCP_MAX_STEPS.
# PSCAT_MCP_TASK_AFTER_MS=2000
# Wall-clock deadline of one job's worker, in ms (SIGKILL after it, `timeout`).
# The PSCat plugin uses 3600000.
# PSCAT_MCP_JOB_TIMEOUT_MS=600000
# PSCat step limit of a job. Unset: 25000000000 (PSCat's own default for
# untrusted programs, the plugin's), or PSCAT_MCP_MAX_STEPS if larger; 0 when
# PSCAT_MCP_MAX_STEPS is 0.
# PSCAT_MCP_JOB_MAX_STEPS=25000000000
# Jobs running at once; more wait queued. Below PSCAT_MCP_MAX_CONCURRENT_RENDERS
# (1 with a single slot). Unset: half the render slots, at least 1.
# PSCAT_MCP_MAX_RUNNING_JOBS=2
# Queued or running jobs per client (bearer token) and in all (`server_busy`).
# PSCAT_MCP_MAX_JOBS_PER_PRINCIPAL=4
# PSCAT_MCP_MAX_JOBS=16
# How long a finished job and its result are kept, in ms.
# PSCAT_MCP_JOB_RESULT_TTL_MS=3600000
# Memory for job results, all jobs together (`results_budget_exceeded`). Each
# job reserves its largest result (PSCAT_MCP_MAX_OUTPUT_BYTES as base64, plus
# stdout and 4 KiB) while it runs; must hold at least one. At the defaults
# that is about 11 MiB, so 128 MiB holds about 11 unfinished jobs and
# `results_budget_exceeded` comes before PSCAT_MCP_MAX_JOBS (16); about
# 180 MiB lets the cap bind first. The results live in the server process:
# add this to its memory.
# PSCAT_MCP_JOB_RESULTS_BUDGET_BYTES=134217728
# Bytes of that budget one client (bearer token; the stdio user) may have
# reserved and held, so one client cannot fill it and get the others' jobs
# refused (`results_budget_exceeded`, error.input.code
# `results_per_principal_bytes`). Unset: the budget less one largest result
# (about 117 MiB of 128), or the whole budget if it holds fewer than two.
# At least one largest result, at most the budget; equal to the budget it
# turns the share off. When the budget or the share is short, results
# already fetched are dropped first, the requesting client's own before
# anyone else's.
# PSCAT_MCP_JOB_RESULTS_PER_PRINCIPAL_BYTES=100663296

# ---------------------------------------------------------------------------
# Artifact links (the `delivery` argument; README, "Artifact links")
# ---------------------------------------------------------------------------

# Where `delivery` url/both links point: off (url and both are refused with
# invalid_request), memory (kept in this process and read with resources/read
# of pscat://render/<render_id>/<n>; one instance only, lost on restart) or
# gcs (uploaded to Cloud Storage and linked by https V4 signed URLs; see
# docs/CLOUD_RUN.md for the grants). memory and gcs are refused with the
# `none` auth method.
# PSCAT_MCP_ARTIFACT_LINKS=off
# The delivery of a call that gives none: inline, url, both or auto. Anything
# but inline needs links on. An argument overrides it.
# PSCAT_MCP_ARTIFACT_DELIVERY=inline
# With delivery auto: output over this many bytes (all artifacts, before
# base64) comes back as links, the rest inline.
# PSCAT_MCP_ARTIFACT_THRESHOLD_BYTES=1048576
# How long a link works, in seconds; the memory store drops the bytes then.
# With gcs, the signed URL's lifetime: at most 604800 (7 days).
# PSCAT_MCP_ARTIFACT_URL_TTL_SECS=1800
# Stored output one client may hold at once (`results_budget_exceeded`,
# error.input.code `artifact_quota_bytes`). memory links are refused with the
# `none` auth method (one anonymous client could fill the shared budget). At least
# PSCAT_MCP_MAX_OUTPUT_BYTES plus 1 KiB; at most
# PSCAT_MCP_JOB_RESULTS_BUDGET_BYTES, which all stored output and job results
# share (also when async jobs are off).
# With gcs: bytes one client may upload within one TTL, counted per server
# instance (not bounded by the results budget).
# PSCAT_MCP_ARTIFACT_QUOTA_BYTES=33554432

# gcs only. The bucket (required), the object name prefix (objects are
# <prefix><render_id>/<n>.<ext>; must end in /, no leading /, no ..), the
# account that signs the URLs through IAM Credentials signBlob (default: the
# account the metadata server reports), and the timeout of each call to the
# metadata server, IAM or Storage. Credentials come from the metadata server
# only: there is no key or key-file setting.
# PSCAT_MCP_ARTIFACT_BUCKET=
# PSCAT_MCP_ARTIFACT_PREFIX=renders/
# PSCAT_MCP_ARTIFACT_SIGNER=
# PSCAT_MCP_ARTIFACT_GCS_TIMEOUT_MS=10000
# For tests only (a local fake of the Google APIs): the base URLs of the
# metadata server, IAM Credentials and Storage uploads; https, or http on a
# loopback host. Never set them in a deployment.
# PSCAT_MCP_ARTIFACT_GCS_METADATA_ENDPOINT=
# PSCAT_MCP_ARTIFACT_GCS_IAM_ENDPOINT=
# PSCAT_MCP_ARTIFACT_GCS_STORAGE_ENDPOINT=

# ---------------------------------------------------------------------------
# Debugging
# ---------------------------------------------------------------------------

# Capture mode (serve-http only), off by default: append every /mcp request
# that passed authentication to this file as one JSON line. Recorded: the
# method and path, the values of Accept, Content-Type, MCP-Protocol-Version,
# Mcp-Session-Id, Mcp-Method, Mcp-Name, User-Agent and Host, the NAMES of
# all other headers, only the scheme of Authorization, the body (cut at
# 64 KiB), and the response status. Never recorded: tokens, other header
# values, the query string. The file holds the PostScript sources clients
# send, so serve-http refuses to start with it unless the bind address is
# loopback (127.0.0.1 or ::1): local debugging only. The container's root filesystem
# is read-only: mount a writable path to use it there. See
# docs/LOCAL_TESTING.md, "Server-layer evals".
# PSCAT_MCP_CAPTURE_FILE=/tmp/pscat-capture.jsonl

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Executable started (with the hidden `render-worker` subcommand) for each
# render. Unset: the server's own binary. Leave unset in the container.
# PSCAT_MCP_WORKER_EXE=/usr/local/bin/pscat-mcp-server

# A PSCat data root holding font packs, e.g. one written by
# `PSCAT_HOME=/srv/pscat-data pscat fonts install --pack cjk-thai`: the packs
# are in <dir>/fonts/packs/<pack>/. Passed to the workers as their PSCAT_HOME
# and nothing else of the environment. Programs still cannot read it. The
# server refuses to start if the path is missing or not a directory. Unset
# (the default): only PSCat's compiled-in fonts. In the container, mount the
# directory read-only (docs/CLOUD_RUN.md, "Font packs").
# PSCAT_MCP_FONT_PACK_DIR=/fonts
