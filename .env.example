# pscat-mcp-server configuration (container / Cloud Run environment).
#
# Copy to .env for local use (`docker run --env-file .env ...`); .env is
# git- and docker-ignored. Every variable is optional unless noted; the
# value shown is the built-in default, except where marked "example".
# Each variable also has a matching command-line flag (`--help`).
# Never commit real tokens: in production use a secret manager and
# PSCAT_MCP_AUTH_TOKEN_FILE (a mounted secret) or a secret-backed env var.

# ---------------------------------------------------------------------------
# HTTP transport (serve-http)
# ---------------------------------------------------------------------------

# Address to bind. The binary defaults to 127.0.0.1; the container image sets
# 0.0.0.0 so the published port is reachable.
PSCAT_MCP_BIND=0.0.0.0

# Port to listen on. Cloud Run injects PORT itself.
PORT=8080

# REQUIRED unless a token file is given (or unauthenticated loopback dev).
# Bearer tokens accepted on /mcp, comma-separated, so tokens can be rotated
# by listing old and new together. Generate with: openssl rand -hex 32
PSCAT_MCP_AUTH_TOKENS=replace-with-a-long-random-token

# Alternative to the above: a file with one token per line (blank lines and
# `#` comments ignored), e.g. a Cloud Run secret mounted as a volume.
# Tokens from both sources are accepted.
# PSCAT_MCP_AUTH_TOKEN_FILE=/secrets/pscat-mcp-tokens

# Serve /mcp without authentication. Refused unless the bind address is
# loopback, so it cannot be used inside a container bound to 0.0.0.0.
# Local development only.
PSCAT_MCP_ALLOW_UNAUTHENTICATED=false

# Host header values accepted (DNS-rebinding protection), comma-separated.
# Set this to your public hostname, e.g. pscat-mcp-abc123-uc.a.run.app.
# `*` accepts any host: only behind a proxy that already validates Host.
PSCAT_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Browser origins accepted, comma-separated. Empty (default): any request
# carrying an Origin header is rejected; MCP clients do not send one.
# PSCAT_MCP_ALLOWED_ORIGINS=https://example.com

# Seconds to wait for in-flight requests after SIGTERM before exiting.
# Cloud Run allows 10 s by default.
PSCAT_MCP_SHUTDOWN_GRACE_SECS=8

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# json (default for serve-http, one object per line on stderr) or pretty.
PSCAT_MCP_LOG_FORMAT=json

# tracing filter; overrides the default `info`.
# RUST_LOG=info,pscat_mcp=debug

# ---------------------------------------------------------------------------
# Resource limits (one render)
# ---------------------------------------------------------------------------

# Largest PostScript source accepted, in bytes (256 KiB). Checked before
# anything runs: larger sources fail with `source_too_large`.
PSCAT_MCP_MAX_SOURCE_BYTES=262144

# Largest LaTeX formula chalkboard_math accepts, in bytes (the PSCat
# plugin's default). Checked before anything runs (`source_too_large`). A
# ten-row derivation is about 1 KB; a much longer formula may not finish
# inside the render timeout.
PSCAT_MCP_MAX_LATEX_BYTES=4096

# Wall-clock deadline per render, in ms. The worker process is SIGKILLed when
# it passes (`timeout`).
PSCAT_MCP_RENDER_TIMEOUT_MS=20000

# PSCat's own time limit, in ms. Unset: the render timeout minus 10% (at
# least 250 ms), so runaways usually stop cleanly with `limit_exceeded`
# before the kill. 0 disables it (the kill still applies). Must be below
# PSCAT_MCP_RENDER_TIMEOUT_MS.
# PSCAT_MCP_INTERP_TIME_LIMIT_MS=18000

# PSCat's step limit (objects executed). 0 disables it.
PSCAT_MCP_MAX_STEPS=5000000000

# PSCat's heap-growth limit for one program, in bytes (512 MiB). 0 disables.
PSCAT_MCP_MAX_MEMORY_BYTES=536870912

# RLIMIT_AS for each worker process, in bytes. Unset: the memory limit plus
# 1 GiB of headroom. 0 disables. Keep it under the container memory limit
# times the number of concurrent renders you allow.
# PSCAT_MCP_WORKER_ADDRESS_SPACE_BYTES=1610612736

# Most device pixels on one page (width x height at the requested dpi).
# Larger pages fail with `too_many_pixels` before execution. PSCat also caps
# each side at 8000 px (`invalid_dimensions`).
PSCAT_MCP_MAX_PIXELS=16000000

# Most pages one render may return (`too_many_pages`).
PSCAT_MCP_MAX_PAGES=10

# Most bytes of rendered output (all pages, before base64) returned inline
# (8 MiB, `output_too_large`).
PSCAT_MCP_MAX_OUTPUT_BYTES=8388608

# Most bytes of program stdout (`print`, `=`, `==`) returned (16 KiB).
PSCAT_MCP_MAX_PROGRAM_OUTPUT_BYTES=16384

# Renders running at once. Unset: the CPU count, at most 4. Each render is
# one worker process, so memory use scales with this.
# PSCAT_MCP_MAX_CONCURRENT_RENDERS=2

# How long a render waits for a free slot before `server_busy`, in ms.
PSCAT_MCP_QUEUE_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Debugging
# ---------------------------------------------------------------------------

# Capture mode (serve-http only), off by default: append every /mcp request
# that passed authentication to this file as one JSON line. Recorded: the
# method and path, the values of Accept, Content-Type, MCP-Protocol-Version,
# Mcp-Session-Id, Mcp-Method, Mcp-Name, User-Agent and Host, the NAMES of
# all other headers, only the scheme of Authorization, the body (cut at
# 64 KiB), and the response status. Never recorded: tokens, other header
# values, the query string. The file holds the PostScript sources clients
# send, so serve-http refuses to start with it unless the bind address is
# loopback (127.0.0.1 or ::1): local debugging only. The container's root filesystem
# is read-only: mount a writable path to use it there. See
# docs/LOCAL_TESTING.md, "Server-layer evals".
# PSCAT_MCP_CAPTURE_FILE=/tmp/pscat-capture.jsonl

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Executable started (with the hidden `render-worker` subcommand) for each
# render. Unset: the server's own binary. Leave unset in the container.
# PSCAT_MCP_WORKER_EXE=/usr/local/bin/pscat-mcp-server
